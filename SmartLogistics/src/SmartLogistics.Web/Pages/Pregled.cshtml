@page
@model PregledModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = "Pregled";
}

<partial name="_PageHeader" model="vm.Header" />

@if (vm.PendingDecisionsText is not null)
{
    <div class="sl-callout sl-callout-warning" role="status">
        <span class="sl-callout-icon">@Icons.Get("alert")</span>
        <div>
            <strong>@vm.PendingDecisionsText</strong>
            Pregledaj prijedloge u <a asp-page="/Dokumentacija" asp-route-slug="odluke">zapisu odluka</a>.
        </div>
    </div>
}

<div class="sl-callout sl-callout-info" role="status">
    <span class="sl-callout-icon">@Icons.Get("info")</span>
    <div>
        <a asp-page="/Index">Ulazni podaci</a> su početna stranica; <a asp-page="/Orders/Index">naloge</a> možeš dodavati, mijenjati
        i brisati (i stroj teži od nosivosti kamiona), a <a asp-page="/Plan">plan prijevoza</a> se odmah računa egzaktnim planerom
        nad izmijenjenim podacima, uz izbor načina i trajanja radnog dana, provjeru validatorom i SVG kartu ruta.
    </div>
</div>

<section class="sl-stat-grid" aria-label="Ključni pokazatelji">
    @foreach (var stat in vm.Stats)
    {
        <partial name="_StatTile" model="stat" />
    }
</section>

<div class="row g-4">
    <section class="col-xl-5">
        <div class="sl-card h-100">
            <div class="sl-card-header">
                <h2 class="sl-card-title">Napredak projekta</h2>
            </div>
            <div class="sl-card-body">
                <partial name="_PhaseTimeline" model="vm.Phases" />
            </div>
        </div>
    </section>

    <section class="col-xl-7">
        <div class="sl-card h-100">
            <div class="sl-card-header">
                <h2 class="sl-card-title">Dokumentacija</h2>
                <a class="sl-card-action" asp-page="/Dokumentacija">Sve @Icons.Get("arrow-right")</a>
            </div>
            <div class="sl-card-body">
                <div class="sl-doc-grid">
                    @foreach (var document in vm.Documents)
                    {
                        <partial name="_DocumentCard" model="document" />
                    }
                </div>
            </div>
        </div>
    </section>
</div>
