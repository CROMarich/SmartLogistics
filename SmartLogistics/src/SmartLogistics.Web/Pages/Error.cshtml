@page
@model ErrorModel
@{
    ViewData["Title"] = "Greška";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel("Greška", "Nešto je pošlo po zlu", "Došlo je do pogreške pri obradi zahtjeva."))" />

@if (Model.ShowRequestId)
{
    <div class="callout is-danger" role="alert">
        <span class="callout-icon">@Icons.Get("alert")</span>
        <div><strong>ID zahtjeva:</strong> <code>@Model.RequestId</code></div>
    </div>
}
