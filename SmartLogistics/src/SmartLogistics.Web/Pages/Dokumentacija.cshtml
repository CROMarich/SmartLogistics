@page "{slug?}"
@model DokumentacijaModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = vm.Current.Title;
}

<partial name="_PageHeader" model="vm.Header" />

<nav class="segmented" aria-label="Dokumenti">
    @foreach (var document in vm.Documents)
    {
        <a class="segmented-item @(document.Slug == vm.Current.Slug ? "is-active" : null)"
           asp-page="/Dokumentacija" asp-route-slug="@document.Slug"
           aria-current="@(document.Slug == vm.Current.Slug ? "page" : null)">
            @Icons.Get(document.Icon)
            <span>@document.Title</span>
        </a>
    }
</nav>

<div class="chip-row doc-meta-row">
    <span class="chip">@vm.Current.FileName</span>
    <span class="chip">zadnja izmjena: @vm.Current.LastModifiedText</span>
    @foreach (var stat in vm.Current.Stats)
    {
        <span class="chip">@stat</span>
    }
</div>

@if (vm.Body is null)
{
    <div class="callout is-warning" role="status">
        <span class="callout-icon">@Icons.Get("alert")</span>
        <div>Dokument <code>@vm.Current.FileName</code> još ne postoji.</div>
    </div>
}
else
{
    <div class="row g-4">
        @if (vm.Outline.Count > 0)
        {
            <aside class="col-lg-3 order-lg-2">
                <partial name="_DocumentOutline" model="vm.Outline" />
            </aside>
        }
        <article class="col-lg-9 order-lg-1">
            <div class="panel">
                <div class="panel-body markdown-body">
                    @vm.Body
                </div>
            </div>
        </article>
    </div>
}
