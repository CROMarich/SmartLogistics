@page
@model IndexModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = "Pregled";
}

<partial name="_PageHeader" model="vm.Header" />

@if (vm.PendingDecisionsText is not null)
{
    <div class="callout is-warning" role="status">
        <span class="callout-icon">@Icons.Get("alert")</span>
        <div>
            <strong>@vm.PendingDecisionsText</strong>
            Pregledaj prijedloge u <a asp-page="/Dokumentacija" asp-route-slug="odluke">zapisu odluka</a>.
        </div>
    </div>
}

<div class="callout is-info" role="status">
    <span class="callout-icon">@Icons.Get("info")</span>
    <div>
        Ulazni podaci, plan ruta po kamionima i karta pojavit će se u izborniku <strong>Planiranje</strong>
        kad budu implementirani u <code>SmartLogistics.Core</code>.
    </div>
</div>

<section class="stat-grid" aria-label="Ključni pokazatelji">
    @foreach (var stat in vm.Stats)
    {
        <partial name="_StatTile" model="stat" />
    }
</section>

<div class="row g-4">
    <section class="col-xl-5">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">Napredak projekta</h2>
            </div>
            <div class="panel-body">
                <partial name="_PhaseTimeline" model="vm.Phases" />
            </div>
        </div>
    </section>

    <section class="col-xl-7">
        <div class="panel h-100">
            <div class="panel-header">
                <h2 class="panel-title">Dokumentacija</h2>
                <a class="panel-action" asp-page="/Dokumentacija">Sve @Icons.Get("arrow-right")</a>
            </div>
            <div class="panel-body">
                <div class="doc-grid">
                    @foreach (var document in vm.Documents)
                    {
                        <partial name="_DocumentCard" model="document" />
                    }
                </div>
            </div>
        </div>
    </section>
</div>
