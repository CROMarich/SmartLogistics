@page
@model IndexModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = vm.Header.Title;
}

<partial name="_PageHeader" model="vm.Header" />
<partial name="_FlashMessage" />
<partial name="_FormErrors" model="ModelState.FormErrors()" />

@if (vm.Error is not null)
{
    <div class="sl-callout sl-callout-danger" role="alert">
        <span class="sl-callout-icon">@Icons.Get("alert")</span>
        <div><strong>Scenarij nije učitan.</strong> @vm.Error</div>
    </div>
}

<partial name="_ScenarioStatus" model="vm.Status" />

@if (vm.Error is null)
{
    <div class="sl-chip-row sl-meta-row">
        @foreach (var fact in vm.Facts)
        {
            <span class="sl-chip">@fact</span>
        }
    </div>

    <section class="sl-stat-grid" aria-label="Sažetak ulaznih podataka">
        @foreach (var stat in vm.Stats)
        {
            <partial name="_StatTile" model="stat" />
        }
    </section>

    <div class="row g-4">
        <section class="col-xl-5">
            <div class="sl-card h-100">
                <div class="sl-card-header"><h2 class="sl-card-title">@Icons.Get("truck") Kamioni</h2></div>
                <partial name="_TrucksTable" model="vm.Trucks" />
            </div>
        </section>

        <section class="col-xl-7">
            <div class="sl-card h-100">
                <div class="sl-card-header"><h2 class="sl-card-title">@Icons.Get("layers") Strojevi</h2></div>
                <partial name="_MachinesTable" model="vm.Machines" />
            </div>
        </section>

        <section class="col-12">
            <div class="sl-card">
                <div class="sl-card-header">
                    <h2 class="sl-card-title">@Icons.Get("list") Nalozi</h2>
                    <a class="sl-card-action" asp-page="/Orders/Index">Uredi naloge @Icons.Get("arrow-right")</a>
                </div>
                <partial name="_OrdersTable" model="vm.Orders" />
            </div>
        </section>

        <section class="col-xl-5">
            <div class="sl-card h-100">
                <div class="sl-card-header"><h2 class="sl-card-title">@Icons.Get("map") Lokacije</h2></div>
                <partial name="_LocationsTable" model="vm.Locations" />
            </div>
        </section>

        <section class="col-xl-7">
            <div class="sl-card h-100">
                <div class="sl-card-header">
                    <h2 class="sl-card-title">Karta lokacija i naloga</h2>
                    <a class="sl-card-action" asp-page="/Plan">Plan prijevoza @Icons.Get("arrow-right")</a>
                </div>
                <div class="sl-card-body">
                    @if (vm.Map is not null)
                    {
                        <partial name="_LocationMap" model="vm.Map" />
                    }
                    else
                    {
                        <span class="sl-cell-muted">Scenarij nema nijednu lokaciju.</span>
                    }
                </div>
            </div>
        </section>

        @if (vm.Matrix is not null)
        {
            <section class="col-12">
                <div class="sl-card">
                    <div class="sl-card-header">
                        <h2 class="sl-card-title">Matrica udaljenosti (km)</h2>
                        <span class="sl-chip">simetrična · dijagonala 0</span>
                    </div>
                    <partial name="_DistanceMatrix" model="vm.Matrix" />
                </div>
            </section>
        }
    </div>
}
