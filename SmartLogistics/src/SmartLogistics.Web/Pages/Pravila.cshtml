@page
@model PravilaModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = vm.Header.Title;
}

<partial name="_PageHeader" model="vm.Header" />

@if (vm.Error is not null)
{
    <div class="sl-callout sl-callout-danger" role="alert">
        <span class="sl-callout-icon">@Icons.Get("alert")</span>
        <div>@vm.Error</div>
    </div>
}

<section class="sl-stat-grid" aria-label="Pokrivenost pravila">
    @foreach (var stat in vm.Stats)
    {
        <partial name="_StatTile" model="stat" />
    }
</section>

<div class="row g-4">
    @if (vm.Demo is not null)
    {
        <section class="col-12">
            <div class="sl-card">
                <div class="sl-card-header">
                    <h2 class="sl-card-title">@vm.Demo.Title</h2>
                    <span class="sl-chip">uživo: PlanValidator.Validate</span>
                </div>
                <div class="sl-card-body">
                    <p class="sl-card-lead">@vm.Demo.Description</p>
                    <div class="@vm.Demo.SummaryCssClass" role="status">
                        <span class="sl-callout-icon">@Icons.Get(vm.Demo.ValidatorAvailable ? "check" : "clock")</span>
                        <div>@vm.Demo.Summary</div>
                    </div>
                </div>
                @if (vm.Demo.Violations.Count > 0)
                {
                    <partial name="_ViolationTable" model="vm.Demo.Violations" />
                }
            </div>
        </section>
    }

    <section class="col-12">
        <div class="sl-card">
            <div class="sl-card-header"><h2 class="sl-card-title">Pravila iz specifikacije</h2></div>
            <div class="table-responsive">
                <table class="table sl-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Pravilo</th>
                            <th scope="col">Izvor</th>
                            <th scope="col">Validator</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in vm.Rules)
                        {
                            <tr>
                                <td class="fw-semibold">@rule.Id</td>
                                <td class="sl-rule-text">@rule.Text</td>
                                <td class="sl-cell-muted">@rule.Source</td>
                                <td>
                                    @if (rule.CheckedByValidator)
                                    {
                                        <span class="sl-badge sl-badge-ok">provjerava</span>
                                    }
                                    else
                                    {
                                        <span class="sl-badge sl-badge-neutral">–</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
