@model TruckPlanViewModel

<article class="panel truck-plan">
    <div class="panel-header">
        <h2 class="panel-title">
            <span class="@Model.Badge.CssClass">@Model.Badge.Text</span>
            @Model.Title
        </h2>
        <div class="chip-row">
            <span class="chip">@Model.Km</span>
            <span class="chip">@Model.Orders</span>
        </div>
    </div>

    @if (Model.IsUnused)
    {
        <div class="panel-body">
            <span class="badge-soft is-neutral">neiskorišten</span>
            <span class="cell-muted">Kamion nema nijednu radnju (0 km).</span>
        </div>
    }
    else
    {
        <div class="panel-body truck-plan-summary">
            <dl class="kv-list">
                <div><dt>Vožnja</dt><dd>@Model.DrivingTime</dd></div>
                <div><dt>Radnje</dt><dd>@Model.ActionTime</dd></div>
                <div><dt>Ukupno</dt><dd>@Model.TotalTime</dd></div>
            </dl>
            <div class="workday">
                <div class="workday-label">Radni dan: @Model.WorkdayText</div>
                <meter class="workday-meter" min="0" max="@Model.WorkdayMax" value="@Model.WorkdayValue"
                       aria-label="Iskorištenost radnog dana (@Model.WorkdayLabel)">@Model.WorkdayText</meter>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table data-table route-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-end">#</th>
                        <th scope="col">Lokacija</th>
                        <th scope="col">Radnja</th>
                        <th scope="col">Nalog · stroj</th>
                        <th scope="col" class="text-end">Teret nakon</th>
                        <th scope="col" class="text-end">Strojeva</th>
                        <th scope="col" class="text-end">Dionica km</th>
                        <th scope="col" class="text-end">Ukupno km</th>
                        <th scope="col" class="text-end">Vrijeme</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="@(row.IsBaseRow ? "is-base-row" : null)">
                            <td class="text-end num cell-muted">@row.Step</td>
                            <td class="fw-semibold">@row.Location</td>
                            <td><span class="@row.ActionCssClass">@row.ActionText</span></td>
                            <td>@row.Order</td>
                            <td class="text-end num">@row.Load</td>
                            <td class="text-end num">@row.Machines</td>
                            <td class="text-end num">@row.LegKm</td>
                            <td class="text-end num">@row.CumulativeKm</td>
                            <td class="text-end num">@row.Time</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>
