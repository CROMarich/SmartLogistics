@model IReadOnlyList<OutlineItemViewModel>

<nav class="doc-outline" aria-label="Sadržaj dokumenta">
    <div class="doc-outline-title">Sadržaj</div>
    <ul class="doc-outline-list">
        @foreach (var item in Model)
        {
            <li class="@(item.IsSubsection ? "is-sub" : null)">
                <a href="@item.Anchor">@item.Text</a>
            </li>
        }
    </ul>
</nav>
