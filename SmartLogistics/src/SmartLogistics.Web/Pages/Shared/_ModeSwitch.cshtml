@model PlanPageViewModel
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
}

<div class="switch-group">
    <div class="switch-label">Scenarij</div>
    <nav class="segmented" aria-label="Scenarij">
        @foreach (var scenario in Model.Scenarios)
        {
            <a class="segmented-item @(scenario.IsActive ? "is-active" : null)"
               asp-page="@currentPage" asp-route-scenarij="@scenario.Id" asp-route-nacin="@Model.ActiveModeQuery"
               aria-current="@(scenario.IsActive ? "page" : null)">
                @Icons.Get("database")
                <span>@scenario.Title</span>
            </a>
        }
    </nav>
</div>

<div class="switch-group">
    <div class="switch-label">Radni dan</div>
    <nav class="segmented" aria-label="Način računanja radnog dana">
        @foreach (var mode in Model.Modes)
        {
            <a class="segmented-item @(mode.IsActive ? "is-active" : null)"
               asp-page="@currentPage" asp-route-nacin="@mode.QueryValue" asp-route-scenarij="@Model.ActiveScenarioId"
               aria-current="@(mode.IsActive ? "page" : null)">
                @Icons.Get("clock")
                <span>@mode.Text</span>
            </a>
        }
    </nav>
</div>
