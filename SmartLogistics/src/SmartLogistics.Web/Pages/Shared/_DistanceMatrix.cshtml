@model DistanceMatrixViewModel

<div class="table-responsive">
    <table class="table sl-matrix">
        <thead>
            <tr>
                <th scope="col" class="sl-matrix-corner">od \ do</th>
                @foreach (var header in Model.Headers)
                {
                    <th scope="col" class="text-end">@header</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <th scope="row">@row.LocationId</th>
                    @foreach (var cell in row.Cells)
                    {
                        <td class="text-end sl-num @(cell.IsDiagonal ? "sl-matrix-diagonal" : null)">@cell.Text</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
