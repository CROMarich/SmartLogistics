@model MapViewModel

<figure class="map">
    <svg class="map-canvas" viewBox="@Model.ViewBox" role="img" aria-label="Karta lokacija sa strelicama">
        <defs>
            @* One arrowhead per colour; the colour comes from site.css *@
            <marker id="arrow-any" class="map-arrowhead is-any" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="arrow-truck-a" class="map-arrowhead is-truck-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="arrow-truck-b" class="map-arrowhead is-truck-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="arrow-none" class="map-arrowhead is-none" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
        </defs>

        @foreach (var arrow in Model.Arrows)
        {
            <line class="@arrow.CssClass" x1="@arrow.X1" y1="@arrow.Y1" x2="@arrow.X2" y2="@arrow.Y2">
                <title>@arrow.Title</title>
            </line>
        }

        @foreach (var point in Model.Points)
        {
            <g class="map-location @(point.IsBase ? "is-base" : null)">
                <circle cx="@point.Cx" cy="@point.Cy" r="@Model.PointRadius" />
                <text x="@point.LabelX" y="@point.LabelY">@point.Id</text>
            </g>
        }
    </svg>

    <figcaption class="map-legend">
        @foreach (var item in Model.Legend)
        {
            <span class="map-legend-item"><span class="@item.SwatchCssClass"></span>@item.Text</span>
        }
    </figcaption>
</figure>
