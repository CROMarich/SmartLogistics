@model LocationMapViewModel

<figure class="sl-map">
    <svg class="sl-map-canvas" viewBox="@Model.Frame.ViewBox" role="img" aria-label="Karta lokacija s nalozima (strelica od preuzimanja do isporuke)">
        <defs>
            @* One arrowhead per colour; the colour comes from site.css *@
            <marker id="order-arrow-any" class="sl-map-arrowhead sl-map-arrowhead-any" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="order-arrow-truck-a" class="sl-map-arrowhead sl-map-arrowhead-truck-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="order-arrow-truck-b" class="sl-map-arrowhead sl-map-arrowhead-truck-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
            <marker id="order-arrow-none" class="sl-map-arrowhead sl-map-arrowhead-none" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" /></marker>
        </defs>

        <partial name="_MapFrame" model="Model.Frame" />

        @foreach (var arrow in Model.Arrows)
        {
            <line class="@arrow.CssClass" x1="@arrow.X1" y1="@arrow.Y1" x2="@arrow.X2" y2="@arrow.Y2">
                <title>@arrow.Title</title>
            </line>
        }

        @foreach (var location in Model.Locations)
        {
            <g class="@location.CssClass">
                <circle cx="@location.X" cy="@location.Y" r="@Model.PointRadius" />
                <text x="@location.LabelX" y="@location.LabelY">@location.Id</text>
            </g>
        }
    </svg>

    <figcaption class="sl-map-legend">
        @foreach (var item in Model.Legend)
        {
            <span class="sl-map-legend-item"><span class="@item.SwatchCssClass"></span>@item.Text</span>
        }
    </figcaption>
</figure>
