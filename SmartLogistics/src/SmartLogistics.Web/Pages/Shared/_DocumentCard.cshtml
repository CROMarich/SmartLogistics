@model DocumentCardViewModel

<article class="sl-doc-card @(Model.Exists ? null : "sl-doc-card-missing")">
    <div class="sl-doc-card-head">
        <span class="sl-doc-card-icon">@Icons.Get(Model.Icon)</span>
        <div>
            <h3 class="sl-doc-card-title">@Model.Title</h3>
            <div class="sl-doc-card-file">@Model.FileName</div>
        </div>
    </div>
    <p class="sl-doc-card-text">@Model.Description</p>
    <div class="sl-chip-row">
        @foreach (var stat in Model.Stats)
        {
            <span class="sl-chip">@stat</span>
        }
    </div>
    <div class="sl-doc-card-foot">
        <span class="sl-doc-card-date">@Model.LastModifiedText</span>
        @if (Model.Exists)
        {
            <a class="sl-doc-card-link stretched-link" asp-page="/Dokumentacija" asp-route-slug="@Model.Slug">
                Otvori @Icons.Get("arrow-right")
            </a>
        }
        else
        {
            <span class="sl-badge sl-badge-neutral">Još nije napisano</span>
        }
    </div>
</article>
