<!DOCTYPE html>
<html lang="hr">
@inject SmartLogistics.Web.Services.UpRentWebsite UpRentWebsite
@{
    var navigation = NavigationMenu.Build(new NavigationContext(
        ViewContext.RouteData.Values["page"] as string,
        UpRentWebsite.IsAvailable ? Url.Content("~" + SmartLogistics.Web.Services.UpRentWebsite.StartPage) : null));
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Smart Logistics · UpRent</title>
    @* Self-hosted brand fonts (wwwroot/fonts, OFL); preloading the two most used faces avoids a late font swap. *@
    <link rel="preload" href="~/fonts/barlow-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/barlow-condensed-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sl-app-body">
    <a class="sl-skip-link" href="#main-content">Preskoči na sadržaj</a>

    <div class="sl-shell">
        @* ==================== Region: sidebar (desktop, lg and up) ====================
           Dark (ink) fixed column: UpRent logo with the app name, navigation, short footer note. *@
        <aside class="sl-sidebar d-none d-lg-flex">
            <header class="sl-sidebar-header">
                <partial name="_AppBrand" />
            </header>
            <partial name="_AppNavigation" model="navigation" />
            <div class="sl-sidebar-footer">
                <span class="sl-sidebar-footer-title">Tehnički zadatak</span>
                <span>ASP.NET Core · .NET 10</span>
            </div>
        </aside>

        @* ==================== Region: navigation (mobile, below lg) ====================
           The same navigation in a Bootstrap off-canvas panel, opened from the top bar. *@
        <div class="offcanvas offcanvas-start sl-offcanvas" tabindex="-1" id="appNavigation" aria-labelledby="appNavigationTitle">
            <header class="offcanvas-header">
                <div id="appNavigationTitle" class="sl-offcanvas-title"><partial name="_AppBrand" /></div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Zatvori izbornik"></button>
            </header>
            <div class="offcanvas-body">
                <partial name="_AppNavigation" model="navigation" />
            </div>
        </div>

        <div class="sl-main">
            @* ==================== Region: header (mobile top bar) ==================== *@
            <header class="sl-topbar d-lg-none">
                <button class="sl-icon-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#appNavigation"
                        aria-controls="appNavigation" aria-label="Otvori izbornik">
                    @Icons.Get("menu")
                </button>
                <partial name="_AppBrand" />
            </header>

            @* ==================== Region: main (page content) ==================== *@
            <main id="main-content" class="sl-content">
                @RenderBody()
            </main>

            @* ==================== Region: footer ==================== *@
            <footer class="sl-footer">
                <span class="sl-footer-brand">Smart Logistics</span>
                <span>Planiranje prijevoza radnih strojeva · UpRent</span>
            </footer>
        </div>
    </div>

    @* ==================== Region: scripts ====================
       Only the Bootstrap bundle (off-canvas menu); pages add their own scripts in the "Scripts" section. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
