<!DOCTYPE html>
<html lang="hr">
@{
    var navigation = NavigationMenu.Build(ViewContext.RouteData.Values["page"] as string);
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Smart Logistics Planner</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <a class="skip-link" href="#main-content">Preskoči na sadržaj</a>

    <div class="app-shell">
        @* Desktop: fixed sidebar *@
        <aside class="app-sidebar d-none d-lg-flex" aria-label="Glavni izbornik">
            <partial name="_AppBrand" />
            <partial name="_AppNavigation" model="navigation" />
            <div class="app-sidebar-footer">Tehnički zadatak · .NET 10</div>
        </aside>

        @* Mobile: the same navigation in an off-canvas panel *@
        <div class="offcanvas offcanvas-start app-offcanvas" tabindex="-1" id="appNavigation" aria-labelledby="appNavigationTitle">
            <div class="offcanvas-header">
                <span id="appNavigationTitle"><partial name="_AppBrand" /></span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Zatvori izbornik"></button>
            </div>
            <div class="offcanvas-body">
                <partial name="_AppNavigation" model="navigation" />
            </div>
        </div>

        <div class="app-main">
            <header class="app-topbar d-lg-none">
                <button class="app-icon-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#appNavigation"
                        aria-controls="appNavigation" aria-label="Otvori izbornik">
                    @Icons.Get("menu")
                </button>
                <span class="app-topbar-title">Smart Logistics Planner</span>
            </header>

            <main id="main-content" class="app-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                Smart Logistics Planner · planiranje prijevoza radnih strojeva
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
