@model IReadOnlyList<ViolationRowViewModel>

<div class="table-responsive">
    <table class="table sl-table">
        <thead>
            <tr>
                <th scope="col">Pravilo</th>
                <th scope="col">Kamion</th>
                <th scope="col" class="text-end">Korak</th>
                <th scope="col">Poruka validatora</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var violation in Model)
            {
                <tr>
                    <td><span class="sl-badge sl-badge-danger">@violation.RuleId</span></td>
                    <td>@violation.Truck</td>
                    <td class="text-end sl-num">@violation.Step</td>
                    <td class="sl-cell-muted">@violation.Message</td>
                </tr>
            }
        </tbody>
    </table>
</div>
