@model IReadOnlyList<string>
@* Errors that belong to the whole form (ModelState key ""), e.g. a failed store operation. *@

@if (Model.Count > 0)
{
    <div class="sl-callout sl-callout-danger" role="alert">
        <span class="sl-callout-icon">@Icons.Get("alert")</span>
        <div>
            @if (Model.Count == 1)
            {
                @Model[0]
            }
            else
            {
                <ul class="sl-callout-list">
                    @foreach (var error in Model)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    </div>
}
