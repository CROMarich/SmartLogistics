@model StatTileViewModel

<div class="stat-tile @Model.ToneCssClass">
    <div class="stat-icon">@Icons.Get(Model.Icon)</div>
    <div>
        <div class="stat-label">@Model.Label</div>
        <div class="stat-value">@Model.Value</div>
        <div class="stat-hint">@Model.Hint</div>
    </div>
</div>
