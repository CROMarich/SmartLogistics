@model PlanPageViewModel

<partial name="_ModeSwitch" model="Model.Modes" />

@if (Model.Error is not null)
{
    <div class="callout is-danger" role="alert">
        <span class="callout-icon">@Icons.Get("alert")</span>
        <div><strong>Plan nije izračunat.</strong> @Model.Error</div>
    </div>
}
else
{
    <div class="chip-row doc-meta-row">
        @foreach (var fact in Model.Facts)
        {
            <span class="chip">@fact</span>
        }
    </div>

    <div class="@Model.StatusCssClass" role="status">
        <span class="callout-icon">@Icons.Get(Model.StatusIcon)</span>
        <div>@Model.StatusText</div>
    </div>
}
